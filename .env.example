# PLACEHOLDERS ONLY - copy to `.env` (gitignored) for docker compose and to
# `web/.env.local` (gitignored) for Next.js. Never commit real credentials,
# tokens or connection strings.

# Local Docker PostgreSQL (docker-compose.yml reads .env automatically)
POSTGRES_DB=smart_tank
POSTGRES_USER=smart_tank
POSTGRES_PASSWORD=smart_tank_dev_only   # LOCAL DEV placeholder only

# Next.js server-side (Route Handlers only; never exposed to the browser)
DATABASE_URL=postgres://smart_tank:smart_tank_dev_only@localhost:5432/smart_tank

# Device ingestion bearer token (S22+): replace with a long random value.
# The same value is entered on the device via the provisioning portal (NVS).
DEVICE_INGEST_TOKEN=replace-with-long-random-local-value

# Admin bearer token for POST /api/reports/generate (S27): replace with a
# long random value in production. On Vercel a MISSING token makes the
# endpoint refuse (503) rather than stay open; local dev may leave it unset
# (then the endpoint is open locally by design). Server-side only.
REPORTS_GENERATE_TOKEN=

# Optional bounded-report LLM provider (S12 boundary rules apply; keys are
# deployment secrets, never committed). Leave empty = no provider wired.
# Server-side only (POST /api/reports/generate, S26); never in client code.
# AI_PROVIDER example: openai-compatible. Empty = generation disabled.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL = provider model id. AI_BASEURL = openai-compatible base (…/v1).
AI_MODEL=
AI_BASEURL=

# Data-state semantics (docs/Web_Facade_Architecture.md)
STALE_AFTER_S=180
